# nxcleanup completed P0
# Shared BlueQuartz clang-tidy configuration (simplnx, SimplnxOoc, SimplnxReview, DREAM3DNX).
# Only HeaderFilterRegex and the macro allowlist differ between repositories.
#
# Keep these macros allowed until replacements are found. A TIDY issue tracks the replacements.
# NX_IDENTIFY_SAMPLE_SLICE_READ, NX_IDENTIFY_SAMPLE_SLICE_WRITE, H5SUPPORT_MUTEX_LOCK,
# SIMPLNX_OBSERVE_METADATA_CALL, SIMPLNX_OBSERVE_TYPED_READ, SIMPLNX_OBSERVE_TYPED_WRITE, TEST_LEGACY.
#
# Disabled on purpose (do not re-enable without reading the reason):
#   readability-math-missing-parentheses          : hurts readability of math-heavy code; real precedence bugs
#                                                   are caught by -Wparentheses and friends.
#   cppcoreguidelines-pro-bounds-constant-array-index,
#   cppcoreguidelines-owning-memory                : assume the GSL, which BlueQuartz does not use.
#   cppcoreguidelines-pro-bounds-pointer-arithmetic: raw buffer walking in stores, I/O and engines is intentional.
#   cppcoreguidelines-avoid-const-or-ref-data-members: algorithm classes hold references by design (never null);
#                                                   they are non-copyable, so the assignability cost does not apply.
#   performance-enum-size                          : FILE COMPATIBILITY. Changing an enum's underlying type can
#                                                   change what is written to .dream3d/HDF5 files.
#   misc-no-recursion                              : DataStructure/group traversal is naturally recursive and bounded.
# nxcleanup P2a check bugprone-argument-comment
# nxcleanup P4 check bugprone-chained-comparison
# nxcleanup P4 check bugprone-implicit-widening-of-multiplication-result
# nxcleanup P4 check bugprone-misplaced-widening-cast
# nxcleanup P4 check bugprone-narrowing-conversions
# nxcleanup P4 check bugprone-unused-local-non-trivial-variable
# nxcleanup P4 check clang-analyzer-optin.performance.Padding
# nxcleanup P4 check cppcoreguidelines-avoid-c-arrays
# nxcleanup P4 check cppcoreguidelines-avoid-do-while
# nxcleanup P2b check cppcoreguidelines-init-variables
# nxcleanup P1 check cppcoreguidelines-macro-usage
# nxcleanup P4 check cppcoreguidelines-narrowing-conversions
# nxcleanup P4 check cppcoreguidelines-pro-bounds-array-to-pointer-decay
# nxcleanup P2b check cppcoreguidelines-pro-type-member-init
# nxcleanup P4 check cppcoreguidelines-special-member-functions
# nxcleanup P2a check misc-unused-parameters
# nxcleanup P4 check modernize-avoid-c-arrays
# nxcleanup P2c check modernize-loop-convert
# nxcleanup P2b check modernize-return-braced-init-list
# nxcleanup P2b check modernize-use-designated-initializers
# nxcleanup P2b check modernize-use-emplace
# nxcleanup P2c check modernize-use-ranges
# nxcleanup P2c check modernize-use-std-numbers
# nxcleanup P2b check performance-trivially-destructible
# nxcleanup P2b check performance-unnecessary-copy-initialization
# nxcleanup P2b check performance-unnecessary-value-param
# nxcleanup P4 check readability-avoid-nested-conditional-operator
# nxcleanup P2c check readability-braces-around-statements
# nxcleanup P2c check readability-container-size-empty
# nxcleanup P2b check readability-convert-member-functions-to-static
# nxcleanup P4 check readability-identifier-length
# nxcleanup P2c check readability-implicit-bool-conversion
# nxcleanup P2c check readability-isolate-declaration
# nxcleanup P2c check readability-static-definition-in-anonymous-namespace
# nxcleanup P2c check readability-use-std-min-max
# nxcleanup P4 naming-kind ClassMethod
# nxcleanup P4 naming-kind ConstexprVariable
# nxcleanup P4 naming-kind Function
# nxcleanup P4 naming-kind GlobalFunction
# nxcleanup P3 naming-kind LocalPointer
# nxcleanup P4 naming-kind PublicMember
# nxcleanup P4 naming-kind TypeAlias
# nxcleanup P3 naming-kind Variable
# nxcleanup disabled-by-decision misc-const-correctness: Maintainer decision (2026-11-26) to keep this check off until reconsidered. Adding const to returned or moved locals can turn moves into copies.
# nxcleanup disabled-by-decision misc-include-cleaner: Maintainer decision (2026-11-26) to keep this check off until reconsidered. Include removal can break other platforms or build configurations.

Checks: -abseil-*, bugprone-*, -bugprone-easily-swappable-parameters, -boost-*, -cert-*,
  clang-diagnostic-*, -clang-diagnostic-documentation, clang-analyzer-*, cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers, -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-owning-memory, -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic, -darwin-*, -fuchsia-*, -google-*,
  -hicpp-*, -linuxkernel-*, -llvm-*, misc-*, -misc-no-recursion, modernize-*, -modernize-use-trailing-return-type,
  -modernize-use-nodiscard, -modernize-use-auto, -mpi-*, -objc-*, -openmp-*, performance-*,
  -performance-enum-size, -portability-*, readability-*, -readability-function-cognitive-complexity,
  -readability-function-size, -readability-math-missing-parentheses, -readability-uppercase-literal-suffix,
  -readability-magic-numbers,-bugprone-argument-comment,-bugprone-chained-comparison,-bugprone-implicit-widening-of-multiplication-result,-bugprone-misplaced-widening-cast,-bugprone-narrowing-conversions,-bugprone-unused-local-non-trivial-variable,-clang-analyzer-optin.performance.Padding,-cppcoreguidelines-avoid-c-arrays,-cppcoreguidelines-avoid-do-while,-cppcoreguidelines-init-variables,-cppcoreguidelines-macro-usage,-cppcoreguidelines-narrowing-conversions,-cppcoreguidelines-pro-bounds-array-to-pointer-decay,-cppcoreguidelines-pro-type-member-init,-cppcoreguidelines-special-member-functions,-misc-unused-parameters,-modernize-avoid-c-arrays,-modernize-loop-convert,-modernize-return-braced-init-list,-modernize-use-designated-initializers,-modernize-use-emplace,-modernize-use-ranges,-modernize-use-std-numbers,-performance-trivially-destructible,-performance-unnecessary-copy-initialization,-performance-unnecessary-value-param,-readability-avoid-nested-conditional-operator,-readability-braces-around-statements,-readability-container-size-empty,-readability-convert-member-functions-to-static,-readability-identifier-length,-readability-implicit-bool-conversion,-readability-isolate-declaration,-readability-static-definition-in-anonymous-namespace,-readability-use-std-min-max,-misc-const-correctness,-misc-include-cleaner
WarningsAsErrors: '*'
HeaderFilterRegex: .*/MTRSim/(src|test|tests|wrapping|cmake)/.*\.(h|hpp)$
ExcludeHeaderFilterRegex: .*/3rd[Pp]arty/.*
FormatStyle: file
CheckOptions:
  cppcoreguidelines-macro-usage.AllowedRegexp: (^((SIMPLNX|SIMPLNXCORE|NXIMAGEPROCESSING|ORIENTATIONANALYSIS|TESTONE|TESTTWO)_(EXPORT(_H)?|NO_EXPORT|NO_DEPRECATED|DEPRECATED(_(NO_)?EXPORT)?)|SIMPLNX_(TEMPLATE|PLUGIN)_EXPORT|MM_(CELL_MAP|GEOMETRY_GL|GEOMETRY_OBJ|SURFACE_NET)_H|ADD_PARAMETER_TRAIT|SIMPLNX_(DEF|NAMESPACE_CONCAT)|SIMPLNX_DEF_(FILTER|PARAMETER)_TRAITS(_NAMED|_NAMEDSPACED)?|SIMPLNX_DEF_PLUGIN(_IMPL)?|SIMPLNX_(CREATE|DESTROY)_PLUGIN_FUNC(_NAME)?|SIMPLNX_(STRINGIFY|TEXT)(_IMPL)?|SIMPLNX_INSTANTIATE_RECONSTRUCT_SWEEP_(RUN_IMPL|SERIAL_MEMBERS)|SIMPLNX_PY_BIND_[A-Z0-9_]+|CATCH_CONFIG_(MAIN|RUNNER)|SIMPLNX_RESULT_(REQUIRE_(VALID|INVALID)|CATCH_PRINT)|SIMPLNX_TEST_(ALGORITHM_PATH|RESTORE_NOMINMAX)|CANVAS_ITY_IMPLEMENTATION|STB_IMAGE(_WRITE)?_IMPLEMENTATION|NOMINMAX|SIMPLNX_(BUILD_TESTS|BYTE_ORDER|EMBED_PYTHON|ENABLE_MULTICORE|PYTHON_MODULE|STORE_COPY_STRICT_FORMAT|WRITE_TEST_OUTPUT)|H5_USE_110_API|H5Support_USE_MUTEX|PYBIND11_DETAILED_ERROR_MESSAGES|_SILENCE_CXX17_ITERATOR_BASE_CLASS_DEPRECATION_WARNING|NX_IDENTIFY_SAMPLE_SLICE_(READ|WRITE)|H5SUPPORT_MUTEX_LOCK|SIMPLNX_OBSERVE_(METADATA_CALL|TYPED_(READ|WRITE))|TEST_LEGACY)$)|^(LIBMTRSIM_EXPORT|MTRSIM_(EXPORT(_H)?|NO_EXPORT|NO_DEPRECATED|DEPRECATED(_(NO_)?EXPORT)?))$
  cppcoreguidelines-init-variables.MathHeader: <cmath>
  misc-include-cleaner.IgnoreHeaders: Eigen/.*;fmt/.*;nlohmann/.*;catch2/.*;pybind11/.*;tbb/.*;oneapi/.*;Qt[A-Za-z0-9]*/.*;Qt[A-Za-z0-9]*\.framework/.*
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  cppcoreguidelines-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  readability-identifier-length.IgnoredVariableNames: ^([xyzijk]|[dn][xyz])$
  readability-identifier-length.IgnoredParameterNames: ^([xyzijk]|[dn][xyz])$
  readability-identifier-length.IgnoredLoopCounterNames: ^([xyzijk]|[dn][xyz])$
  readability-identifier-naming.IgnoreMainLikeFunctions: 'false'
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.ClassIgnoredRegexp: ^(const_)?iterator$
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.ClassMethodCase: CamelCase
  # Enable ClassMethod in P4 after its findings are resolved.
  readability-identifier-naming.ClassMethodIgnoredRegexp: .*
  readability-identifier-naming.MethodCase: camelBack
  readability-identifier-naming.MethodIgnoredRegexp: ^(at|back|begin|capacity|cbegin|cend|c_str|c_view|clear|compare|contains|copy|crbegin|crend|data|emplace|emplace_back|emplace_front|empty|end|ends_with|erase|find|find_first_not_of|find_first_of|find_last_not_of|find_last_of|front|get_allocator|insert|insert_or_assign|length|lower_bound|max_size|merge|npos|pop_back|pop_front|push_back|push_front|rbegin|rend|replace|reserve|resize|rfind|shrink_to_fit|size|starts_with|str|substr|swap|try_emplace|upper_bound|view|kdtree_get_point_count|kdtree_get_pt|kdtree_get_bbox|kdtree_distance)$
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.GlobalFunctionCase: CamelCase
  # Enable GlobalFunction in P4 after its findings are resolved.
  readability-identifier-naming.GlobalFunctionIgnoredRegexp: .*
  readability-identifier-naming.PrivateMemberPrefix: m_
  readability-identifier-naming.PrivateMemberCase: CamelCase
  readability-identifier-naming.ProtectedMemberPrefix: m_
  readability-identifier-naming.ProtectedMemberCase: CamelCase
  readability-identifier-naming.PublicMemberCase: lower_case
  # Enable PublicMember in P4 after its findings are resolved.
  readability-identifier-naming.PublicMemberIgnoredRegexp: .*
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.LocalPointerCase: camelBack
  readability-identifier-naming.LocalPointerSuffix: Ptr
  readability-identifier-naming.GlobalVariableCase: CamelCase
  readability-identifier-naming.GlobalConstantCase: CamelCase
  readability-identifier-naming.GlobalConstantPrefix: k_
  readability-identifier-naming.GlobalConstantIgnoredRegexp: ^k_[A-Za-z0-9]+_Key$
  readability-identifier-naming.ConstexprVariableCase: CamelCase
  readability-identifier-naming.ConstexprVariablePrefix: k_
  # Enable ConstexprVariable in P4 after its findings are resolved.
  readability-identifier-naming.ConstexprVariableIgnoredRegexp: .*
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypeAliasSuffix: Type
  # Enable TypeAlias in P4 after its findings are resolved.
  readability-identifier-naming.TypeAliasIgnoredRegexp: .*
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  # Enable Function in P4 after its findings are resolved.
  readability-identifier-naming.FunctionIgnoredRegexp: .*
  # Enable LocalPointer in P3 after its findings are resolved.
  readability-identifier-naming.LocalPointerIgnoredRegexp: .*
  # Enable Variable in P3 after its findings are resolved.
  readability-identifier-naming.VariableIgnoredRegexp: .*
